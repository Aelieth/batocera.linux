#!/bin/bash
# Format a USB disk as SNES-<id> + SAVES. Never touches nvme.
#   sneshd-format-cart --device /dev/sdX --id ADVN [--raid] [--saves-mb 1024] --yes

set -eu
. /usr/lib/sneshd/sneshd-common.sh

DEVICE=""
CART_ID=""
RAID=0
SAVES_MB=1024
YES=0

usage() {
    echo "Usage: $0 --device /dev/sdX --id NAME [--raid] [--saves-mb 1024] --yes" >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --device) DEVICE="${2:-}"; shift 2 ;;
        --id) CART_ID="${2:-}"; shift 2 ;;
        --raid) RAID=1; shift ;;
        --saves-mb) SAVES_MB="${2:-}"; shift 2 ;;
        --yes) YES=1; shift ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
done

[ "$YES" -eq 1 ] || { echo "Refusing to format without --yes" >&2; exit 1; }
[ -n "$DEVICE" ] && [ -b "$DEVICE" ] || { echo "Bad --device" >&2; exit 1; }
echo "$DEVICE" | grep -qE '^/dev/nvme' && { echo "Refusing to format NVMe (console disk)" >&2; exit 1; }
echo "$CART_ID" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_-]*$' || { echo "Bad --id" >&2; exit 1; }
echo "$SAVES_MB" | grep -qE '^[0-9]+$' || { echo "Bad --saves-mb" >&2; exit 1; }

# Disable yank while we rebuild the disk
mkdir -p "$SNESHD_RUN"
echo "MODE=admin" > "$SNESHD_SESSION"
echo "YANK=0" >> "$SNESHD_SESSION"

# Drop any mounts on this disk
lsblk -nrpo NAME,MOUNTPOINT "$DEVICE" | awk '$2 ~ /^\// {print $2}' | sort -r | while read -r mp; do
    umount -l "$mp" 2>/dev/null || true
done

LABEL="SNES-${CART_ID}"
BYTES=$(blockdev --getsize64 "$DEVICE")
TOTAL_MIB=$((BYTES / 1024 / 1024))
if [ "$TOTAL_MIB" -le $((SAVES_MB + 64)) ]; then
    echo "Device too small (${TOTAL_MIB} MiB)" >&2
    exit 1
fi
SAVES_START=$((TOTAL_MIB - SAVES_MB))

echo "Wiping partition table on $DEVICE"
dd if=/dev/zero of="$DEVICE" bs=1M count=8 status=none
parted -s "$DEVICE" mklabel gpt

part_name() {
    local n="$1"
    if [ -b "${DEVICE}${n}" ]; then
        echo "${DEVICE}${n}"
    else
        echo "${DEVICE}p${n}"
    fi
}

if [ "$RAID" -eq 1 ]; then
    MID=$(( (SAVES_START - 1) / 2 + 1 ))
    parted -s "$DEVICE" \
        mkpart primary 1MiB "${MID}MiB" \
        mkpart primary "${MID}MiB" "${SAVES_START}MiB" \
        mkpart primary "${SAVES_START}MiB" 100%
    partprobe "$DEVICE" || true
    sleep 1
    P1=$(part_name 1)
    P2=$(part_name 2)
    P3=$(part_name 3)
    mkfs.btrfs -f -L "$LABEL" "$P1"
    mkfs.btrfs -f "$P2"
    mkfs.btrfs -f -L SAVES "$P3"
    TMP=$(mktemp -d)
    mount "$P1" "$TMP"
    btrfs device add -f "$P2" "$TMP"
    btrfs balance start -dconvert=raid1 -mconvert=raid1 "$TMP"
    mkdir -p "$TMP/batocera/roms/snes" "$TMP/batocera/themes" "$TMP/batocera/system"
    umount "$TMP"
    rmdir "$TMP"
else
    parted -s "$DEVICE" \
        mkpart primary 1MiB "${SAVES_START}MiB" \
        mkpart primary "${SAVES_START}MiB" 100%
    partprobe "$DEVICE" || true
    sleep 1
    P1=$(part_name 1)
    P2=$(part_name 2)
    mkfs.btrfs -f -L "$LABEL" "$P1"
    mkfs.btrfs -f -L SAVES "$P2"
    TMP=$(mktemp -d)
    mount "$P1" "$TMP"
    mkdir -p "$TMP/batocera/roms/snes" "$TMP/batocera/themes" "$TMP/batocera/system"
    umount "$TMP"
    rmdir "$TMP"
fi

echo "Formatted $DEVICE as $LABEL + SAVES (raid=$RAID)"
